# ── Warm Terminal / Cozy Archive — mako notifications ───────────────────────
# Square, thick-bordered "instrument readout" toasts on parchment.

font=Departure Mono 10
background-color=#F3E9D8
text-color=#2B2420
border-color=#C97B3D
progress-color=over #E3D5B8

border-size=2
border-radius=0
padding=10
margin=8
width=340
height=120
default-timeout=6000
icons=1
max-icon-size=32
anchor=top-right
outer-margin=12,12

[urgency=low]
border-color=#7C8B6F
text-color=#5C4A2E

[urgency=normal]
border-color=#C97B3D

[urgency=critical]
border-color=#B5654F
default-timeout=0
