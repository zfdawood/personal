# ── Warm Terminal / Cozy Archive — mako notifications ───────────────────────
# Square, thick-bordered "instrument readout" toasts.
# mako has no include directive, so this whole file is a template; $${role}
# placeholders are filled from tokens.toml [roles.<mode>].

font=Departure Mono 10
background-color=${bgPrimary}
text-color=${textPrimary}
border-color=${accent}
progress-color=over ${bgAlt}

border-size=2
border-radius=0
padding=10
margin=8
width=340
height=120
default-timeout=6000
icons=1
max-icon-size=32
anchor=top-right
outer-margin=12,12

[urgency=low]
border-color=${good}
text-color=${textSecondary}

[urgency=normal]
border-color=${accent}

[urgency=critical]
border-color=${warning}
default-timeout=0
