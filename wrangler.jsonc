// Cloudflare Workers static assets: the dashboard's Git flow (Workers Builds) runs
// `npm run build`, then `npx wrangler deploy`, which uploads dist/ as the site.
// "name" must match the Worker's name in the dashboard.
{
  "name": "site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths get index.html, so Elm's router handles deep links and its own 404.
    "not_found_handling": "single-page-application"
  }
}
